<!doctype html>
<html lang="en">
  <body style="margin:0;padding:24px;background:#081120;color:#eaf0ff;font-family:Arial,sans-serif">
    <div style="max-width:640px;margin:auto;padding:28px;border:1px solid #293752;border-radius:18px;background:#101b30">
      <p style="margin:0;color:#67f5da;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase">Private CV request</p>
      <h1 style="margin:10px 0 24px;font-size:26px">Someone requested your CV</h1>
      <table style="width:100%;border-collapse:collapse;color:#eaf0ff">
        <tr><td style="padding:8px 0;color:#8fa0bd">Full name</td><td style="padding:8px 0">{{fullName}}</td></tr>
        <tr><td style="padding:8px 0;color:#8fa0bd">Email</td><td style="padding:8px 0">{{email}}</td></tr>
        <tr><td style="padding:8px 0;color:#8fa0bd">Company</td><td style="padding:8px 0">{{company}}</td></tr>
      </table>
      <h2 style="margin:24px 0 8px;font-size:17px">Reason for requesting</h2>
      <p style="margin:0;color:#c6d1e5;line-height:1.65;white-space:pre-wrap">{{reason}}</p>
    </div>
  </body>
</html>
