# Runtime
NODE_ENV=development
PORT=3000
# Number of trusted reverse proxies in front of Express; verify if adding another proxy
TRUST_PROXY_HOPS=1
# Comma-separated origins allowed to call the API. The production portfolio and
# local Angular origins are built in; add preview or custom domains here.
CLIENT_ORIGIN=https://oboikanyego-portfolio.netlify.app,http://localhost:4200,http://127.0.0.1:4200

# Optional DNS resolvers for MongoDB SRV lookups
DNS_SERVERS=8.8.8.8,1.1.1.1

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio
# MONGO_URI is supported temporarily for existing deployments.
# In-process cache duration for the public site configuration (milliseconds)
SITE_CONFIG_CACHE_TTL_MS=300000

# Resend HTTPS email notifications. For an initial test, onboarding@resend.dev
# can send only to the email address associated with your Resend account.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Portfolio <onboarding@resend.dev>
CONTACT_RECEIVER=your-email@example.com

# Admin authentication
# Run `npm run admin:set-password` after copying this file to .env.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_TOKEN_SECRET=

# Cloudinary image storage; keep API secret only in Render, never in Angular or GitHub
CLOUDINARY_CLOUD_NAME=dv2hhefed
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Optional Netlify SEO rebuild automation. Create a build hook for main on the portfolio site.
# This URL is a secret; do not commit the real value.
NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/REPLACE_WITH_HOOK_ID

# Owner-only Firebase Cloud Messaging. The first six values are public web app
# configuration. Get them from Firebase Console > Project settings > General,
# and Cloud Messaging > Web Push certificates (VAPID public key).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_PUBLIC_KEY=
# Server-only Google service account values. NEVER add these to frontend assets.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
