# Runtime
NODE_ENV=development
PORT=3000
# Number of trusted reverse proxies in front of Express; verify if adding another proxy
TRUST_PROXY_HOPS=1
# Comma-separated origins allowed to call the API. The production portfolio and
# local Angular origins are built in; add preview or custom domains here.
CLIENT_ORIGIN=https://oboikanyego-portfolio.netlify.app,http://localhost:4200,http://127.0.0.1:4200

# Optional DNS resolvers for MongoDB SRV lookups
DNS_SERVERS=8.8.8.8,1.1.1.1

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/portfolio?retryWrites=true&w=majority
# In-process cache duration for the public site configuration (milliseconds)
SITE_CONFIG_CACHE_TTL_MS=300000

# Resend HTTPS email notifications. For an initial test, onboarding@resend.dev
# can send only to the email address associated with your Resend account.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Portfolio <onboarding@resend.dev>
CONTACT_RECEIVER=your-email@example.com

# Admin authentication
# Run `npm run admin:set-password` after copying this file to .env.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_TOKEN_SECRET=
